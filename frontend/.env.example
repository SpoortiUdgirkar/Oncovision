# ==========================================
# OncoVision Frontend Environment Variables Example
# Copy this file to frontend/.env and fill in your actual deployment credentials.
# Note: VITE_ variables are embedded in browser bundles and public!
# DO NOT place secret service-role keys here.
# ==========================================

# Backend API Endpoint URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase Public Anon Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
