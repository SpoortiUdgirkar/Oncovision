# ==========================================
# OncoVision Backend Environment Variables Example
# Copy this file to .env and fill in your actual deployment credentials.
# NEVER commit real credentials or secret keys to Git.
# ==========================================

# FastAPI Server Port & CORS
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Supabase Project Credentials (Backend Service Role)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# PyTorch & Model Execution Settings
MODEL_PATH=models/efficientnet_b0_exp1_256_best.pth
TORCH_NUM_THREADS=1
